{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Pylos window may do: reveal itself, open the xAI verification page, choose a bundle file, and run its own sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:event:default",
    "opener:default",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/pylos-server", "sidecar": true, "args": ["serve"] }]
    }
  ]
}
